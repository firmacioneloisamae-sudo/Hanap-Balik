# Generate a secret with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-secret

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ID_ENCRYPTION_KEY=replace-with-a-generated-fernet-key

# Local development uses SQLite. PostgreSQL/Supabase URLs are also supported.
DATABASE_URL=sqlite:///hanapbalik.db

# Set COOKIE_SECURE=true when serving the site over HTTPS.
COOKIE_SECURE=false
